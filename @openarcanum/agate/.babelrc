{
  "presets": [
    ["@babel/preset-env",
    {
      "debug": true,
      "targets": {
        "electron": "4",
        "node": "current"
      }
    }],
    "@babel/preset-flow"
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    "@babel/plugin-transform-flow-strip-types",
    "@babel/plugin-syntax-dynamic-import",
    ["@babel/plugin-proposal-decorators", { "legacy": true }],
    ["@babel/plugin-proposal-class-properties", { "loose": true }]

  ]
}
