{
  "parser": "babel-eslint",
  "extends": "eslint:recommended",
  "plugins": [
    "require-path-exists"
  ],
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "no-mixed-spaces-and-tabs": "off",
    "require-path-exists/notEmpty": 2,
    "require-path-exists/tooManyArguments": 2,
    "require-path-exists/exists": [ 2, {
      "extensions": [
        "",
        ".jsx",
        ".es.js",
        ".jsx",
        ".json5",
        ".es",
        ".es6",
        ".coffee"
      ]
    }]
  }
} 
