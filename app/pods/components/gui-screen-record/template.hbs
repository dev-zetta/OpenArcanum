{{yield}}

{{#if authUrl}}
  {{gui-google-auth authUrl=authUrl onAuthCode=(action onAuthCode)}}
{{/if}}

<vbox>
  <hbox>
    {{#bs-button type=(if recording 'primary' 'danger') onClick=(action "toggleRecorder")}}
      {{if recording 'Stop' 'Record'}}{{#if recordTime }}<strong>{{recordTime}}s</strong>{{/if}}
    {{/bs-button}}

    {{#if downloadUrl}}
      <a class="btn btn-info ember-view" href={{downloadUrl}} download={{videoName}} target="_blank">Download</a>

      {{#bs-button type="info" onClick=(action "upload")}}
        {{if uploading 'Uploading...' 'Upload'}}
      {{/bs-button}}
    {{/if}}
  </hbox>

  <hbox>
    {{#if uploading}}
      {{#bs-progress as |p|}}
        {{p.bar value=uploadProgress minValue=0 maxValue=100 showLabel=true roundDigits="true" type="success" striped="true" animate="true"}}
      {{/bs-progress}}
    {{/if}}
  </hbox>

  <hbox>
    {{#if downloadUrl}}
    Video saved at:<br />
    {{localVideoPath}}
    {{/if}}
  </hbox>

</vbox>

