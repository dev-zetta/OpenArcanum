{
  "name": "open-arcanum",
  "version": "1.0.0",
  "private": true,
  "description": "Work-in-progress Electron/TypeScript reimplementation of Arcanum: Of Steamworks and Magick Obscura",
  "license": "GPL-3.0-or-later",
  "author": "Gabriel Max <dev@zetta.app>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-zetta/OpenArcanum.git"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mts",
    "build:ui": "npm run build:config && vite build",
    "build": "npm run typecheck && npm run build:engine && npm run build:ui && npm run build:desktop && npm run build:converter && npm run build:gui",
    "start": "npm run build && node scripts/electron-launch.cts",
    "start:built": "node scripts/electron-launch.cts",
    "start:workshop": "npm run build && node scripts/workshop-launch.cts",
    "smoke": "node scripts/electron-launch.cts --smoke",
    "smoke:game": "node scripts/electron-launch.cts --smoke-game",
    "smoke:workshop": "node scripts/workshop-launch.cts --smoke-game",
    "test": "node --test --test-isolation=none ember-electron/*.test.cts @openarcanum/agate/tests/*.test.cts @openarcanum/asset-converter/lib/__tests__/*.test.cts",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run build && npm run smoke && npm run smoke:renderer",
    "smoke:renderer": "node @openarcanum/agate/tests/renderer-smoke.cts",
    "test:ui": "npm run build:engine && npm run build:desktop && npm run build:gui && npm run build:ui -- --mode development && node scripts/electron-launch.cts --ui-test",
    "build:desktop": "tsc -p tsconfig.electron.json",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "typecheck:ui": "tsc -p tsconfig.app.json",
    "typecheck:desktop": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck": "npm run check:typescript-sources && npm run typecheck:engine && npm run typecheck:ui && npm run typecheck:desktop && npm run typecheck:converter && npm run typecheck:tests && npm run typecheck:gui && npm run typecheck:research && npm run typecheck:fixture-tools && npm run typecheck:tooling",
    "pretest": "npm run build:config && npm run build:desktop && npm run build:converter && npm run build:gui",
    "build:config": "tsc -p tsconfig.config.json && node scripts/prepare-config.mts",
    "build:converter": "tsc -p tsconfig.converter.json",
    "typecheck:converter": "tsc -p tsconfig.converter.json --noEmit",
    "typecheck:tests": "npm run build:types && npm run build:converter && tsc -p tsconfig.tests.json && tsc -p tsconfig.browser-fixtures.json",
    "build:gui": "tsc -p tsconfig.gui.json",
    "typecheck:gui": "tsc -p tsconfig.gui.json --noEmit",
    "typecheck:research": "tsc -p tsconfig.research.json",
    "typecheck:fixture-tools": "tsc -p tsconfig.fixture-tools.json",
    "build:types": "tsc -p tsconfig.engine-types.json",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json && tsc -p tsconfig.config.json --noEmit",
    "check:typescript-sources": "node scripts/check-typescript-sources.mts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@babel/runtime": "7.29.10",
    "@ember-data/adapter": "5.9.1",
    "@ember-data/model": "5.9.1",
    "@ember-data/serializer": "5.9.1",
    "@ember-data/store": "5.9.1",
    "@ember/optional-features": "3.0.0",
    "@ember/string": "4.0.1",
    "@ember/test-helpers": "5.7.0",
    "@embroider/compat": "4.1.27",
    "@embroider/config-meta-loader": "1.0.0",
    "@embroider/core": "4.6.9",
    "@embroider/macros": "1.21.3",
    "@embroider/router": "3.0.6",
    "@embroider/vite": "1.7.15",
    "@glimmer/component": "2.1.1",
    "@rollup/plugin-babel": "7.1.0",
    "@shopify/draggable": "1.2.1",
    "@types/ember-qunit": "6.1.3",
    "@types/leaflet": "1.9.22",
    "@types/lodash": "4.17.26",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "@types/qunit": "2.19.14",
    "@warp-drive/core": "5.9.1",
    "@warp-drive/ember": "5.9.1",
    "@warp-drive/json-api": "5.9.1",
    "@warp-drive/legacy": "5.9.1",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "bootstrap": "5.3.8",
    "cash-dom": "8.1.5",
    "decorator-transforms": "2.4.0",
    "electron": "44.7.0",
    "ember-cli": "7.3.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-htmlbars": "7.0.1",
    "ember-intl": "9.3.0",
    "ember-load-initializers": "3.0.1",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-source": "7.3.0",
    "esbuild": "0.28.2",
    "jspanel4": "4.16.1",
    "leaflet": "1.9.4",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "video.js": "8.24.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@openarcanum/agate": "file:@openarcanum/agate"
  },
  "main": "dist-electron/main.cjs",
  "workspaces": [
    "@openarcanum/agate",
    "@openarcanum/asset-converter"
  ],
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "ember": {
    "edition": "octane"
  },
  "overrides": {
    "can-symlink": {
      "tmp": "0.2.7"
    },
    "external-editor": {
      "tmp": "0.2.7"
    }
  }
}
