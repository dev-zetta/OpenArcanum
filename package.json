{
  "name": "open-arcanum",
  "version": "1.0.0",
  "private": true,
  "description": "Work-in-progress Electron/JavaScript reimplementation of Arcanum: Of Steamworks and Magick Obscura",
  "license": "GPL-3.0-or-later",
  "author": "Gabriel Max <dev@zetta.app>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-zetta/OpenArcanum.git"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "build:ui": "vite build",
    "build": "npm run build:engine && npm run build:ui",
    "start": "npm run build && node scripts/electron-launch.cjs",
    "start:built": "node scripts/electron-launch.cjs",
    "smoke": "node scripts/electron-launch.cjs --smoke",
    "smoke:game": "node scripts/electron-launch.cjs --smoke-game",
    "test": "node --test --test-isolation=none ember-electron/*.test.cjs @openarcanum/agate/tests/*.test.cjs @openarcanum/asset-converter/lib/__tests__/*.test.js",
    "check": "npm test && npm run test:ui && npm run build && npm run smoke && npm run smoke:renderer",
    "smoke:renderer": "node @openarcanum/agate/tests/renderer-smoke.cjs",
    "test:ui": "npm run build:engine && npm run build:ui -- --mode development && node scripts/electron-launch.cjs --ui-test"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-flow-strip-types": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@ember-data/adapter": "5.9.1",
    "@ember-data/model": "5.9.1",
    "@ember-data/serializer": "5.9.1",
    "@ember-data/store": "5.9.1",
    "@ember/optional-features": "3.0.0",
    "@ember/string": "4.0.1",
    "@ember/test-helpers": "5.7.0",
    "@embroider/compat": "4.1.27",
    "@embroider/config-meta-loader": "1.0.0",
    "@embroider/core": "4.6.9",
    "@embroider/macros": "1.21.3",
    "@embroider/router": "3.0.6",
    "@embroider/vite": "1.7.15",
    "@glimmer/component": "2.1.1",
    "@rollup/plugin-babel": "7.1.0",
    "@shopify/draggable": "1.2.1",
    "@warp-drive/core": "5.9.1",
    "@warp-drive/ember": "5.9.1",
    "@warp-drive/json-api": "5.9.1",
    "@warp-drive/legacy": "5.9.1",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "bootstrap": "5.3.8",
    "cash-dom": "8.1.5",
    "decorator-transforms": "2.4.0",
    "electron": "44.7.0",
    "ember-cli": "7.3.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-htmlbars": "7.0.1",
    "ember-intl": "9.3.0",
    "ember-load-initializers": "3.0.1",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-source": "7.3.0",
    "esbuild": "0.28.2",
    "jspanel4": "4.16.1",
    "leaflet": "1.9.4",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "sass": "1.105.1",
    "video.js": "8.24.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@openarcanum/agate": "file:@openarcanum/agate"
  },
  "main": "ember-electron/main.js",
  "workspaces": [
    "@openarcanum/agate",
    "@openarcanum/asset-converter"
  ],
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "ember": {
    "edition": "octane"
  },
  "overrides": {
    "can-symlink": {
      "tmp": "0.2.7"
    },
    "external-editor": {
      "tmp": "0.2.7"
    }
  }
}
